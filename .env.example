# ──────────────────────────────────────────────────────────────
# Face Detection & Recognition System — Environment Variables
# Copy this file to .env and edit values as needed.
# ──────────────────────────────────────────────────────────────

# YOLOv8 detection
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.35
YOLO_IOU_THRESHOLD=0.45
MIN_FACE_SIZE=48

# Face‐region extraction from person bounding box
FACE_REGION_TOP_RATIO=0.35
FACE_REGION_WIDTH_RATIO=0.60
FACE_PAD_RATIO=0.15

# Blur / quality filter
LAPLACIAN_THRESHOLD=50.0
LAPLACIAN_REF_AREA=10000

# Recognition (cosine similarity)
RECOGNITION_THRESHOLD=0.45
MAX_FACES_PER_FRAME=20

# Feature extraction
FACE_RESIZE_DIM=160
CLAHE_CLIP_LIMIT=2.0
CLAHE_TILE_SIZE=8
LBP_GRID_SIZE=8
LBP_RADIUS=1

# Multi-sample gallery
MAX_SAMPLES_PER_PERSON=5

# Database
DB_PATH=data/faces.db

# Logging
LOG_PATH=logs/app.log

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
MAX_IMAGE_SIZE_MB=10
